# === Server ===
PORT=4000
CORS_ORIGIN=http://localhost:5173

# === Credential encryption ===
# 32-byte (64 hex char) key used for AES-256-GCM encryption of stored broker credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# === LIVE TRADING HARD GATE ===
# This must be explicitly set to "true" for the /api/sessions/live endpoint to ever
# accept a request, no matter what the frontend sends. This is a server-side guard,
# not a UI toggle — it exists so a compromised or buggy frontend can never place a
# live order by itself. Leave unset/false unless you have deliberately decided to
# risk real capital.
LIVE_TRADING_ENABLED=false

# === Alpaca ===
# Paper endpoint (default, always available)
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Live endpoint (only reachable if LIVE_TRADING_ENABLED=true AND live gate consents are 5/5)
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Alpaca keys are NOT set here — they're submitted once via /api/credentials,
# encrypted with CREDENTIAL_ENCRYPTION_KEY, and stored only in encrypted form
# in data/credentials.enc.json. They are never logged or returned in plaintext
# by any API response.
